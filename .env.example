# Copy this file to .env (setup.bat does it for you) and fill in values.
# .env is ignored by git — never commit real values.

# Anthropic API key — used only for: categorizing merchants never seen before,
# learning new PDF layouts, and (Phase 5) Ask Kinsum. Leave empty to keep AI off.
ANTHROPIC_API_KEY=

# Where Kinsum keeps its encrypted database, backups and logs.
# Leave empty to use the default: %LOCALAPPDATA%\Kinsum on Windows,
# ~/Library/Application Support/Kinsum on Mac.
KINSUM_DATA_DIR=

# Port for the local app (only this computer can connect).
KINSUM_PORT=8000

# Lock the app after this many minutes with nobody using it.
KINSUM_IDLE_LOCK_MINUTES=10
